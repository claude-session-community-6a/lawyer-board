---
import Layout from "../layouts/Layout.astro";
import App from "../app/App";
import { listExpedientes } from "../lib/expedientes";

export const prerender = false;

// SSR payload handed to the React app. `path` and `search` prime wouter's
// router so the first server render matches the URL the client hydrates on.
const ssr = {
	path: Astro.url.pathname,
	search: Astro.url.search.replace(/^\?/, ""),
	expedientes: listExpedientes(),
};
---

<Layout title="Expedientes — Despacho">
	<App ssr={ssr} client:load />
</Layout>
